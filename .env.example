# ============================================
# RAG Chatbot - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# All variables are required unless marked optional.

# ============================================
# REQUIRED
# ============================================

# Google API Key — required for Gemini embeddings and chat
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# ============================================
# OPTIONAL - Authentication
# ============================================
# These default to secure values; only change if you need API key auth.

# Comma-separated CORS origins (default: http://localhost:5173 for local dev)
# Include all origins that should be allowed to call the API.
# Example: http://localhost:5173,http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173

# Enable API key authentication (default: false — no auth needed for local dev)
# Set to true and populate API_KEYS to enable.
REQUIRE_AUTH=false

# Comma-separated API keys for authentication (only used if REQUIRE_AUTH=true)
# Example: key1,key2,key3
API_KEYS=

# ============================================
# OPTIONAL - Observability (Phase 12)
# ============================================
# Sentry DSNs for error tracking. Leave empty to disable Sentry.
# Format: https://[email protected]o123456.ingest.sentry.io/1234567
# These are optional — app runs fine without them.

SENTRY_DSN_BACKEND=
VITE_SENTRY_DSN_FRONTEND=

# ============================================
# OPTIONAL - Frontend Build
# ============================================
# URL the frontend uses to reach the backend API.
# Only needed if you change the backend port or use a different hostname.
VITE_API_URL=http://localhost:8000

# ============================================
# PERSISTENCE WARNING (DOCK-04)
# ============================================
# The FAISS index and SQLite database are EPHEMERAL — they are deleted when the
# container restarts. All uploaded documents are lost after restart.
#
# This is by design for v1.2's stateless demo model.
#
# To persist the FAISS index across restarts:
#   1. In docker-compose.yml, uncomment the faiss_data volume mount
#   2. Before the first container restart, run: docker compose up -d
#   3. The volume will persist the index
#
# WARNING: The index is ALWAYS deleted on the FIRST startup after:
#   - "docker compose down -v" (volumes deleted)
#   - A fresh "docker compose up" (new container)
#
# You must mount the volume BEFORE the first restart to preserve data.
# After the first restart with volume mounted, subsequent restarts persist.
#
# There is NO persistence for uploaded files — they live only in the FAISS index.
# ============================================
